#include<iostream>
using namespace std;
int main(){
    int n;
    cout<<"Enter a number-->";
    cin >> n;
    for(int i=1;i<=n;i++){
        //Increaing order
        for(int j=0;j<i;j++){
            cout<<i+j<<" ";
        }
        //Decreasing order
        for(int j=i-2;j>=0;j--){
            cout<<i+j<<" ";
        }
        cout<<endl;
    }
    return 0;
}
