#include<iostream>
using namespace std;
class student{
    private:
        int rollno;
        string name;
    public:
        void setinfo(int r, string n){
            this->rollno=r;
            this->name=n;
        }
        void getinfo(){
            cout<<"Roll No: "<<rollno<<endl;
            cout<<"Name: "<<name<<endl;
        }
};
int main(){
    student s1,s2;
    s1.setinfo(101, "John Doe");
    s2.setinfo(102, "Jane Smith");
    cout<<"Student 1 Info:"<<endl;
    s1.getinfo();
    cout<<"Student 2 Info:"<<endl;
    s2.getinfo();
    return 0;
}
