#include<iostream>
#include<cmath>
using namespace std;
int main(){
    int num,ognum,rem,digit=0;
    int result=0;
    cout<<"Enter a number-->";
    cin>>num;
    ognum=num;
    while(ognum!=0){
        ognum/=10;
        digit++;
    }
    ognum=num;
    while(ognum!=0){
        rem=ognum%10;
        result+=pow(rem,digit);
        ognum/=10;
    }
    if(result==num){
        cout<<num<<" is an Armstrong number";
    }
    else{
        cout<<num<<" is not an Armstrong number";
    }
    return 0;
}
