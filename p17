#include<iostream>
using namespace std;
int main(){
    int a=10;
    float b=5.5;
    char c='A';
    cout<<"Integer: "<<a<<endl;
    cout<<"Float: "<<b<<endl;
    cout<<"Character: "<<c<<endl;
    cout<<"\nArithmetic Operations:"<<endl;
    cout<<"Addition: "<<a+b<<endl;
    cout<<"Subtraction: "<<a-b<<endl;
    cout<<"Multiplication: "<<a*b<<endl;
    cout<<"Division: "<<a/b<<endl;
    return 0;
}
