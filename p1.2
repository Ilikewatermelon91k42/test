#include<iostream>
using namespace std;
int main(){
    int decimal,binary[32],i=0;
    cout<<"Enter a decimal number-->";
    cin>>decimal;
    if(decimal==0){
        cout<<"Binary equivalent is 0";
    }else{
        while(decimal>0){
            binary[i]=decimal%2;
            decimal=decimal/2;
            i++;
        }
        cout<<"Binary equivalent is ";
        for(int j=i-1;j>=0;j--){
            cout<<binary[j];
        }
    }
}
