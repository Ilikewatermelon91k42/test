#include<iostream>
using namespace std;
int main(){
    int n,first=0,second=1,next;
    cout<<"Enter the number of terms-->";
    cin>>n;
    cout<<"Fibonacci series:"<<endl;
    for(int i=0;i<n;i++){
        next=first+second;
        cout<<first<<"+"<<second<<"="<<next<<endl;
        first=second;
        second=next;
    }
    return 0;
}
